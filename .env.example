# Names only. Standard AWS variable names (not the AWS_ACCESS_KEY quirk used in bdl-gamestream-test).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Chime media region for new meetings (e.g. us-east-1, ap-south-1)
CHIME_MEDIA_REGION=us-east-1
# Base URL bots use to reach this app
APP_URL=http://localhost:3100
# Max bots per room
MAX_BOTS=15
# Bots stop themselves when Chime shows no humans left. Seconds to wait after the last human leaves/drops (0 = never):
BOT_LEAVE_GRACE_SECONDS=30
# Minutes to wait for the first human to arrive after bots start (0 = never):
BOT_IDLE_MINUTES=5
# Signs the passwordless login cookie. If unset, a random one is used per server start.
SESSION_SECRET=7b362de068ad790f755e1d9e38561daa7709e8d0fdcf6d49ca42e59fea141289
# Optional shared invite code required at login (leave empty for pure name-only login).
ACCESS_CODE=
# Set to 1 only when serving over https
COOKIE_SECURE=

# Upstash Redis (Vercel Marketplace sets these). Leave empty locally to use in-memory state.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Shared secret so bots (run from your machine) can log in to a deployed server. Use a long random string.
BOT_KEY=34ea2ad441b717ecb69a0bda08b5026ef6b96ffc9eb49aebff9c0c5dce8cb02f
# 1 on your own machine to enable the in-app bot panel; never on Vercel.
ENABLE_BOTS=
