# Names only. Standard AWS variable names (not the AWS_ACCESS_KEY quirk used in bdl-gamestream-test).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Chime media region for new meetings (e.g. us-east-1, ap-south-1)
CHIME_MEDIA_REGION=us-east-1
# Base URL bots use to reach this app
APP_URL=http://localhost:3100
# Max bots per room
MAX_BOTS=10
